{
  // DO 宿主 Worker 配置（RoomDO 类定义在这里，Pages 通过 script_name 跨脚本绑定）
  // 部署：npx wrangler deploy -c wrangler.worker.jsonc
  "name": "gomoku-server",
  "main": "server/worker.js",
  "compatibility_date": "2026-01-15",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ]
}
